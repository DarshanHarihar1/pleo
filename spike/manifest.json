{
  "manifest_version": 3,
  "name": "Pleo Spike M0",
  "version": "0.0.1",
  "description": "Phase 1 extraction spike — DOM extract + React-safe writeback (all_frames)",
  "permissions": [],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["dist/content.js"]
    }
  ]
}
